# Domain and public port that Lampa will use.
ALLOHA_PUBLIC_HOST=resolver.example.com:18443

# Create a private token with: openssl rand -hex 32
ALLOHA_ACCESS_TOKEN=replace_with_64_lowercase_hex_characters

# Port opened by Docker and directory containing the TLS certificate files.
ALLOHA_HTTPS_PORT=18443
ALLOHA_CERT_DIR=./certs

